<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_computed_purchase_order_inherit_form" model="ir.ui.view">
        <field
            name="inherit_id"
            ref="purchase_compute_order.view_computed_purchase_order_form"
        />
        <field name="model">computed.purchase.order</field>
        <field name="arch" type="xml">
            <field name="product_code" position="before">
                <button
                    name="view_history"
                    type="object"
                    icon="fa-history"
                    class="btn-lg"
                    title="View Product History"
                />
            </field>
        </field>
    </record>
</odoo>
