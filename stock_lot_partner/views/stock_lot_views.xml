<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_lot_list_partner" model="ir.ui.view">
        <field name="name">stock.lot.list.partner.location</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree" />
        <field name="arch" type="xml">
            <field name="partner_ids" position="after">
                <field name="current_partner_id" />
            </field>
        </field>
    </record>

    <record id="view_stock_lot_form_partner" model="ir.ui.view">
        <field name="name">stock.lot.form.partner.location</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form" />
        <field name="arch" type="xml">
            <field name="location_id" position="after">
                <field name="current_partner_id" />
            </field>
        </field>
    </record>

    <record id="view_stock_lot_search_partner" model="ir.ui.view">
        <field name="name">stock.lot.search.partner.location</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter" />
        <field name="arch" type="xml">
            <filter name="group_by_location" position="after">
                <filter
                    string="Partner Location"
                    name="group_by_partner_location"
                    context="{'group_by': 'current_partner_id'}"
                />
            </filter>

            <field name="partner_ids" position="after">
                <field name="current_partner_id" />
            </field>
        </field>
    </record>
</odoo>
