<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_vertical_lift_select_shuttle_form" model="ir.ui.view">
        <field name="name">vertical.lift.select.shuttle.form</field>
        <field name="model">vertical.lift.select.shuttle</field>
        <field name="arch" type="xml">
            <form string="Select Shuttle">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        The location <strong>
                        <field
                            name="location_id"
                            readonly="1"
                            options="{'no_open': True}"
                        />
                    </strong>
                        is shared between multiple shuttles. Please select which one to operate.
                    </div>
                    <group>
                        <field name="allowed_shuttle_ids" invisible="1" />
                        <field
                            name="shuttle_id"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field name="res_model" invisible="1" />
                        <field name="res_id" invisible="1" />
                        <field name="method_name" invisible="1" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="z"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vertical_lift_shuttle_selector" model="ir.actions.act_window">
        <field name="name">Select Shuttle</field>
        <field name="res_model">vertical.lift.select.shuttle</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
