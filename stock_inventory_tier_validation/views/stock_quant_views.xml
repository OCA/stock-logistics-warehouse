<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <field name="inventory_quantity_set" position="after">
                <field name="inventory_tier_validation_required" invisible="1" />
            </field>
            <button name="action_apply_inventory" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': ['|', ('inventory_quantity_set', '=', False), ('inventory_tier_validation_required', '=', True)]}</attribute>
            </button>
        </field>
    </record>
    <record id="view_stock_quant_tree_editable" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="inventory_tier_validation_required" invisible="1" />
            </field>
            <field name="inventory_quantity_auto_apply" position="attributes">
                <attribute name="readonly" />
                <attribute
                    name="attrs"
                >{'readonly': [('inventory_tier_validation_required', '=', True)]}</attribute>
            </field>
        </field>
    </record>
</odoo>
