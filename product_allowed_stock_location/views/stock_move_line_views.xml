<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="view_stock_move_line_operation_tree_inherit_allowed_locations"
        model="ir.ui.view"
    >
        <field
            name="name"
        >stock.move.line.operation.tree.inherit.allowed.locations</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
        <field name="priority">100</field>

        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id'][2]" position="replace">
                <field
                    name="location_dest_id"
                    string="Store To"
                    column_invisible="parent.show_quant and parent.picking_code != 'internal'"
                    readonly="package_level_id and parent.picking_type_entire_packs"
                    domain="[('id', 'in', allowed_location_ids)]"
                    groups="stock.group_stock_multi_locations"
                />
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="allowed_location_ids" column_invisible="True" />
            </xpath>
        </field>
    </record>

    <record
        id="view_stock_move_line_detailed_operation_tree_inherit_allowed_locations"
        model="ir.ui.view"
    >
        <field
            name="name"
        >stock.move.line.detailed.operation.tree.inherit.allowed.locations</field>
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"
        />
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_dest_id'][2]" position="replace">
                <field
                    name="location_dest_id"
                    options="{'no_create': True}"
                    column_invisible="context.get('picking_code') == 'outgoing'"
                    readonly="state in ('done', 'cancel') and is_locked"
                    groups="stock.group_stock_multi_locations"
                    domain="[('id', 'in', allowed_location_ids)]"
                />
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="allowed_location_ids" column_invisible="True" />
            </xpath>
        </field>
    </record>
</odoo>
