<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_template_form_inherit_locations" model="ir.ui.view">
        <field name="name">product.template.form.inherit.locations</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Ubicaciones permitidas">
                    <field name="allowed_location_ids" widget="many2many_tags" />
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_product_product_form_inherit_locations" model="ir.ui.view">
        <field name="name">product.product.form.inherit.locations</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Ubicaciones permitidas">
                    <field name="allowed_location_ids" widget="many2many_tags" />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
