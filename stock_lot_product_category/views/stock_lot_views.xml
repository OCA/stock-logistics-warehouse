<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_lot_tree" model="ir.ui.view">
        <field name="name">stock.lot.tree</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_category_id" optional="hide" />
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_search" model="ir.ui.view">
        <field name="name">stock.lot.search</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.search_product_lot_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='group_by_product']" position="before">
                <filter
                    string="Product Category"
                    name="groupby_product_category"
                    context="{'group_by': 'product_category_id'}"
                />
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="product_category_id" />
            </xpath>
        </field>
    </record>
</odoo>
