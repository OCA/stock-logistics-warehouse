<odoo>

    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <button
                name="stock.action_stock_inventory_adjustement_name"
                position="attributes"
            >
                <attribute
                    name="groups"
                    separator=","
                    remove="stock.group_stock_manager"
                    add="stock_inventory_security.group_inventory_adjustment"
                />
            </button>
            <button name="stock.action_stock_request_count" position="attributes">
                <attribute
                    name="groups"
                    separator=","
                    remove="stock.group_stock_manager"
                    add="stock_inventory_security.group_inventory_adjustment"
                />
            </button>
        </field>
    </record>

</odoo>
