<odoo>
    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="name">stock.quant.inventory.tree.editable</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <field name="is_outdated" position="after">
                <field name="is_being_picked" invisible="1" />
            </field>
            <field name="inventory_quantity" position="after">
                <button
                    name="action_view_current_move_lines"
                    type="object"
                    attrs="{'invisible': [('is_being_picked', '=', False)]}"
                    title="Some quantities are currently being picked from this location but not yet validated"
                    class="btn btn-link"
                    icon="fa-truck text-danger"
                />
            </field>
        </field>
    </record>
</odoo>
