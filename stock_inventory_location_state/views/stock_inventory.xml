<odoo>
    <record id="view_inventory_group_form" model="ir.ui.view">
        <field name="name">stock.inventory.form.inherit</field>
        <field name="model">stock.inventory</field>
        <field name="inherit_id" ref="stock_inventory.view_inventory_group_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_open_inventory_locations"
                    invisible="state not in ('in_progress', 'done')"
                    type="object"
                    groups="stock.group_stock_user"
                    icon="fa-list"
                    class="oe_stat_button"
                >
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field
                            name="done_location_count"
                            nolabel="1"
                            class="mr4"
                        /> / <field name="location_count" nolabel="1" />
                        </span>
                        <span class="o_stat_text">Locations</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
