<odoo>
    <record id="view_stock_move_line_detailed_operation_tree" model="ir.ui.view">
        <field
            name="name"
        >stock.move.line.operations.list (stock_move_line_lot_link)</field>
        <field name="model">stock.move.line</field>
        <field
            name="inherit_id"
            ref="stock.view_stock_move_line_detailed_operation_tree"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="after">
                <field
                    invisible="not lot_id"
                    name="lot_id"
                    readonly="1"
                    groups="stock.group_production_lot"
                    widget="button"
                    string="Lot/Serial Number Link"
                    class="text-primary fw-bold"
                    options="{'action': 'action_open_lot'}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_stock_move_line_operation_tree" model="ir.ui.view">
        <field
            name="name"
        >stock.move.line.operations.list.popup (stock_move_line_lot_link)</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']" position="after">
                <field
                    invisible="not lot_id"
                    column_invisible="not parent.lot_ids"
                    name="lot_id"
                    readonly="1"
                    groups="stock.group_production_lot"
                    widget="button"
                    string="Lot/Serial Number Link"
                    class="text-primary fw-bold"
                    options="{'action': 'action_open_lot'}"
                />
            </xpath>
        </field>
    </record>
</odoo>
