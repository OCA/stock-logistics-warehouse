<odoo>
    <record id="recompute_reservation_rate_view_form" model="ir.ui.view">
        <field name="name">stock.recompute.reservation.rate.wizard.form</field>
        <field name="model">recompute.stock.group.reservation.rate</field>
        <field name="arch" type="xml">
            <form string="Recompute Stock Group Reservation Rate">
                <sheet>
                    <div class="oe_grey">
                        This will recompute the reservation rate for all movements
                        that are not draft, cancelled or done and for the selected
                        picking type group.
                    </div>
                    <group>
                        <field name="group_id" />
                    </group>
                </sheet>
                <footer>
                    <button
                        name="recompute"
                        type="object"
                        string="Recompute"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-default" />
                </footer>
            </form>
        </field>
    </record>

    <record id="recompute_reservation_rate_action" model="ir.actions.act_window">
        <field name="name">Recompute Reservation Rate (for Groups)</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">recompute.stock.group.reservation.rate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="recompute_reservation_rate_view_form" />
    </record>

    <record id="action_recompute_reservation_rate_group" model="ir.actions.act_window">
        <field name="name">Recompute Reservation Rate</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">recompute.stock.group.reservation.rate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field
            name="binding_model_id"
            ref="stock_picking_type_group.model_stock_picking_type_group"
        />
    </record>
</odoo>
