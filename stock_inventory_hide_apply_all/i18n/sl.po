msgid "Apply All Inventory Adjustments"
msgstr "Uveljavi vse popravke zalog"

#. module: stock_inventory_hide_apply_all
#: model:res.groups,comment:stock_inventory_hide_apply_all.group_stock_apply_all
msgid ""
"Users in this group can bulk-apply inventory adjustments using the \"Apply "
"All\" button on the inventory adjustment list."
msgstr ""
"Uporabniki v tej skupini lahko popravke zaloge uporabijo v večjem obsegu s "
"pomočjo gumba \"Uveljavi vse\" na seznamu popravkov zaloge."
