<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="30" />
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='use_own_routes']" position="after">
                <setting
                    id="empty_tray_check"
                    help="Operator will verify when system detects an empty vertical tray"
                >
                    <field name="group_stock_adv_location" />
                    <div class="text-muted">
                                If checked and the system thinks the vertical tray is
                                empty, the operator will be asked to explicitly check
                                if this is the case or not
                            </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
