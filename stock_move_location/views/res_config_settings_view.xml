<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings - stock_move_location</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='warning_info']" position="after">
                <setting
                    id="move_location_allow_immediate_transfer"
                    company_dependent="1"
                    help="Show the 'Immediate Transfer' button in the Move from location wizard. If disabled, only planned transfers can be created."
                >
                    <field name="move_location_allow_immediate_transfer" />
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
