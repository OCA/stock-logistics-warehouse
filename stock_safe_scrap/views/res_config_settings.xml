<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div name="operations_setting_container" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="stock_safe_scrap">
                    <div class="o_setting_left_pane">
                        <field name="stock_safe_scrap" />
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="stock_safe_scrap" string="Safe scrap" />
                        <div class="text-muted">
                            If checked, the system will prevent scrap of products if some quantities are currently being picked for the same product, location, lot, owner and package.
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
