<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_warehouse_inherit_lock_location" model="ir.ui.view">
        <field name="name">stock.warehouse.form.lock.location</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='wh_qc_stock_loc_id']" position="after">
                <field name="wh_lock_stock_loc_id" readonly="1" />
            </xpath>
        </field>
    </record>
</odoo>
