<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_history_config_settings" model="ir.ui.view">
        <field name="name">Product History settings</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="product_average_consumption.view_average_consumption_config_settings"
        />
        <field name="arch" type="xml">
            <field name="default_consumption_calculation_method" position="after">
                <div invisible="default_consumption_calculation_method != 'history'">
                    <label for="default_number_of_periods" />
                    <span class="ml16">
                        <field name="default_number_of_periods" />
                    </span>
                    <label for="default_history_range" class="mt8" />
                    <span class="ml16">
                        <field name="default_history_range" />
                    </span>
                </div>
            </field>
        </field>
    </record>
</odoo>
