<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_stock_quant_tree_inventory_editable" model="ir.ui.view">
        <field name="name">stock.quant.inventory.list.editable</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_inventory_editable" />
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field
                    name="secondary_uom_qty"
                    readonly="1"
                    groups="uom.group_uom"
                    optional="show"
                />
                <field name="secondary_uom_id" groups="uom.group_uom" optional="show" />
            </field>
            <field name="inventory_quantity" position="after">
                <field name="secondary_uom_dependency_type" column_invisible="True" />
                <field
                    name="secondary_uom_inventory_quantity"
                    widget="counted_quantity_widget"
                    readonly="not secondary_uom_id or secondary_uom_dependency_type == 'independent'"
                    groups="uom.group_uom"
                    optional="show"
                />
            </field>
        </field>
    </record>
    <record id="view_stock_quant_tree_editable" model="ir.ui.view">
        <field name="name">stock.quant.list.editable</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field
                    name="secondary_uom_qty"
                    readonly="1"
                    sum="Total Secondary Quantity"
                    groups="uom.group_uom"
                    optional="show"
                />
                <field name="secondary_uom_id" groups="uom.group_uom" optional="show" />
            </field>
        </field>
    </record>
</odoo>
