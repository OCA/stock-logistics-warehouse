<odoo>
    <template
        id="report_delivery_document_barcode"
        inherit_id="stock.report_delivery_document"
    >
        <xpath expr="//h2/span[@t-field='o.name']" position="after">
            <t t-if="o.barcode_report_visible and o.barcode">
                <br />
                <img
                    t-att-src="image_data_uri(o.barcode)"
                    style="max-height: 80px;"
                    alt="Picking Barcode"
                />
            </t>
        </xpath>
    </template>
</odoo>
