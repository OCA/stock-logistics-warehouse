<odoo>
    <record model="ir.ui.view" id="stock_picking_type_form_view">
        <field name="model">stock.picking.type</field>
        <field
            name="inherit_id"
            ref="stock_picking_form_barcode.stock_picking_type_form_view"
        />
        <field name="arch" type="xml">
            <field name="display_picking_barcode" position="after">
                <field name="display_report_picking_barcode" />
            </field>
            <field name="picking_barcode_format" position="attributes">
                <attribute
                    name="invisible"
                >not display_picking_barcode and not display_report_picking_barcode</attribute>
            </field>
        </field>
    </record>
</odoo>
