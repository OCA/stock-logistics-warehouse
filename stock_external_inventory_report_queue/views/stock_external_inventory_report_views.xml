<odoo>
    <record id="view_stock_external_inventory_report_form" model="ir.ui.view">
        <field name="name">stock.external.inventory.report.form (queue)</field>
        <field name="model">stock.external.inventory.report</field>
        <field
            name="inherit_id"
            ref="stock_external_inventory_report.view_stock_external_inventory_report_form"
        />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_view_comparison_jobs"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-tasks"
                    groups="base.group_no_one"
                    invisible="not comparison_job_count"
                >
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_value">
                            <field name="comparison_job_count" />
                        </span>
                        <span class="o_stat_text">Jobs</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
