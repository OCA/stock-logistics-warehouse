<odoo>
    <record model="ir.ui.view" id="stock_picking_type_group_form_view">
        <field name="model">stock.picking.type.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="name" />
                    </group>
                    <group>
                        <field
                            name="picking_type_ids"
                            widget="many2many_tags"
                            options="{'no_quick_create': True}"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_picking_type_group_search_view">
        <field name="model">stock.picking.type.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="stock_picking_type_group_tree_view">
        <field name="model">stock.picking.type.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="stock_picking_type_group_act_window">
        <field name="name">Operation Types Group</field>
        <field name="res_model">stock.picking.type.group</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="stock_picking_type_group_menu">
        <field name="name">Operations Types Group</field>
        <field name="parent_id" ref="stock.menu_warehouse_config" />
        <field name="action" ref="stock_picking_type_group_act_window" />
        <!-- To be next operation types-->
        <field name="sequence" eval="3" />
    </record>
</odoo>
