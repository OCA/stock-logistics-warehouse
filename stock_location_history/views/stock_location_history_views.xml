<odoo>
    <!-- LIST -->
    <record id="view_stock_location_history_list" model="ir.ui.view">
        <field name="name">stock.location.history.list</field>
        <field name="model">stock.location.history</field>
        <field name="arch" type="xml">
            <list string="Location Histories">
                <field name="location_id" />
                <field name="product_id" />
                <field name="lot_id" />
                <field name="user_id" />
                <field name="date" />
                <field name="registry_type" />
                <field name="previous_stage_id" />
                <field name="new_stage_id" />
            </list>
        </field>
    </record>

    <record id="action_stock_location_history" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">stock.location.history</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem
        id="menu_operation_stock_location_history"
        name="History"
        parent="stock_location_history.menu_operation_stock_location"
        action="stock_location_history.action_stock_location_history"
        sequence="20"
    />
</odoo>
