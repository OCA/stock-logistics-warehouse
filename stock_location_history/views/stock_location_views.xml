<odoo>
    <!-- FORM -->
    <record id="view_stock_location_form_macrolot" model="ir.ui.view">
        <field name="name">stock.location.form.macrolot</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button
                        name="validate_stage"
                        string="Validate"
                        type="object"
                        class="oe_highlight"
                        icon="fa-check"
                        invisible="not track_stage or last_stage_validated"
                    />
                    <field
                        name="stage_id"
                        widget="statusbar"
                        options="{'clickable': [('last_stage_validated', '=', True)]}"
                        invisible="not track_stage"
                    />
                </header>
            </xpath>
            <xpath expr="//field[@name='storage_category_id']" position="after">
                <field name="track_stage" />
                <field name="lot_id" invisible="not track_stage" />
                <field name="product_id" invisible="not track_stage" />
                <field name="last_stage_validated" invisible="1" />
            </xpath>
        </field>
    </record>

    <!-- LIST -->
    <record id="view_stock_location_history_list" model="ir.ui.view">
        <field name="name">stock.location.history.list</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_tree2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='complete_name']" position="after">
                <field name="track_stage" />
            </xpath>
        </field>
    </record>
</odoo>
